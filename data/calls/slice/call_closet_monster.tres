[gd_resource type="Resource" script_class="CallData" format=3]

[ext_resource type="Script" path="res://data/dialogue/dialogue_node.gd" id="1_88sl5"]
[ext_resource type="Script" path="res://data/dialogue/dialogue_choice.gd" id="2_h355g"]
[ext_resource type="Script" path="res://data/consequences/flag_condition.gd" id="3_p4utw"]
[ext_resource type="Script" path="res://data/dialogue/dialogue_graph.gd" id="4_umgmo"]
[ext_resource type="Script" path="res://data/calls/record_entry.gd" id="5_6vohw"]
[ext_resource type="Script" path="res://data/calls/call_data.gd" id="6_464sf"]
[ext_resource type="Script" path="res://data/calls/stress_profile.gd" id="7_ebu03"]

[sub_resource type="Resource" id="Resource_6ly8r"]
script = ExtResource("2_h355g")
text = "Stay calm. What's your address?"
next = &"address"
patience_delta = 15.0

[sub_resource type="Resource" id="Resource_3qpdh"]
script = ExtResource("2_h355g")
text = "Is there an adult with you?"
next = &"adult"

[sub_resource type="Resource" id="Resource_171q0"]
script = ExtResource("2_h355g")
text = "[Profiler] Let me listen to the room for a moment."
next = &"listen"
required_class = &"profiler"
reveals = Array[StringName]([&"vsa_loop_laughter"])

[sub_resource type="Resource" id="Resource_0gb8e"]
script = ExtResource("1_88sl5")
id = &"start"
line = "Please help! There's a monster in my closet, it's laughing at me!"
choices = Array[ExtResource("2_h355g")]([SubResource("Resource_6ly8r"), SubResource("Resource_3qpdh"), SubResource("Resource_171q0")])

[sub_resource type="Resource" id="Resource_2l4kl"]
script = ExtResource("2_h355g")
text = "Units are on the way. Keep talking to me."
next = &"laughter"

[sub_resource type="Resource" id="Resource_yk2y7"]
script = ExtResource("1_88sl5")
id = &"address"
line = "It's... 14 Birch Lane. Hurry, it's coming out!"
choices = Array[ExtResource("2_h355g")]([SubResource("Resource_2l4kl")])

[sub_resource type="Resource" id="Resource_abmuw"]
script = ExtResource("2_h355g")
text = "Can you go wake him up?"
next = &"laughter"
patience_delta = -20.0

[sub_resource type="Resource" id="Resource_rc8ec"]
script = ExtResource("1_88sl5")
id = &"adult"
line = "My dad is... asleep. Downstairs."
choices = Array[ExtResource("2_h355g")]([SubResource("Resource_abmuw")])

[sub_resource type="Resource" id="Resource_mk5pu"]
script = ExtResource("2_h355g")
text = "I know someone is there with you. Put them on."
next = &"exposed"
required_evidence = Array[StringName]([&"vsa_loop_laughter"])

[sub_resource type="Resource" id="Resource_ucw2g"]
script = ExtResource("2_h355g")
text = "Units are on the way."
next = &"laughter"

[sub_resource type="Resource" id="Resource_mno1v"]
script = ExtResource("1_88sl5")
id = &"listen"
line = "(The same giggle repeats. Behind it, slow adult breathing.)"
choices = Array[ExtResource("2_h355g")]([SubResource("Resource_mk5pu"), SubResource("Resource_ucw2g")])

[sub_resource type="Resource" id="Resource_4n1pm"]
script = ExtResource("1_88sl5")
id = &"laughter"
line = "(Laughter, exactly like before...)"
auto_next = &"hangup"
auto_delay = 4.0

[sub_resource type="Resource" id="Resource_4emss"]
script = ExtResource("1_88sl5")
id = &"exposed"
speaker = &"unknown"
line = "(A man laughs.) Good one, 911. (click)"
auto_next = &"hangup"
auto_delay = 3.0

[sub_resource type="Resource" id="Resource_5o4df"]
script = ExtResource("1_88sl5")
id = &"hangup"
speaker = &"dispatcher"
line = "(The line goes dead.)"

[sub_resource type="Resource" id="Resource_yhidr"]
script = ExtResource("4_umgmo")
nodes = Array[ExtResource("1_88sl5")]([SubResource("Resource_0gb8e"), SubResource("Resource_yk2y7"), SubResource("Resource_rc8ec"), SubResource("Resource_mno1v"), SubResource("Resource_4n1pm"), SubResource("Resource_4emss"), SubResource("Resource_5o4df")])

[sub_resource type="Resource" id="Resource_djmyf"]
script = ExtResource("5_6vohw")
id = &"rec_birch_lane_prank"
title = "14 Birch Lane — prior calls"
content = "Two prank calls logged from this number in the last month. Resident: R. Hale (adult)."

[sub_resource type="Curve" id="Curve_d0b1q"]
_data = [Vector2(0, 0.15), 0.0, 0.0, 0, 0, Vector2(1, 0.18), 0.0, 0.0, 0, 0]
point_count = 2

[sub_resource type="Resource" id="Resource_yj6sc"]
script = ExtResource("7_ebu03")
tremor_curve = SubResource("Curve_d0b1q")
loop_segments = Array[Vector2]([Vector2(3, 6.2), Vector2(6.2, 9.4)])
background_tags = Array[StringName]([&"adult_breathing"])
baseline_heart_rate = 74

[resource]
script = ExtResource("6_464sf")
id = &"call_closet_monster"
title = "Closet Monster"
truth = 0
earliest_minute = 20
dialogue = SubResource("Resource_yhidr")
phone_number = "911-555-0142"
caller_location_name = "14 Birch Lane"
true_location = Vector2(412, 188)
records = Array[ExtResource("5_6vohw")]([SubResource("Resource_djmyf")])
stress_profile = SubResource("Resource_yj6sc")
patience_seconds = 150.0

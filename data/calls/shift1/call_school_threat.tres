[sub_resource type="Resource" id="Resource_uanaj"]
script = ExtResource("2_4ghgh")
text = "Where is the device?"
next = &"where"

[sub_resource type="Resource" id="Resource_3xa3o"]
script = ExtResource("2_4ghgh")
text = "Why are you doing this?"
next = &"why"

[sub_resource type="Resource" id="Resource_bb4uj"]
script = ExtResource("2_4ghgh")
text = "[Profiler] Listen past the voice changer."
next = &"listen"
required_class = &"profiler"
reveals = Array[StringName]([&"game_audio"])

[sub_resource type="Resource" id="Resource_pol6m"]
script = ExtResource("1_x88u4")
id = &"start"
line = "(voice changer) There's a bomb in Blackvale High. It goes off at eight. This is not a joke."
choices = Array[ExtResource("2_4ghgh")]([SubResource("Resource_uanaj"), SubResource("Resource_3xa3o"), SubResource("Resource_bb4uj")])

[sub_resource type="Resource" id="Resource_165w2"]
script = ExtResource("2_4ghgh")
text = "Which one? Gym or math wing?"
next = &"caught_story"
patience_delta = -10.0
reveals = Array[StringName]([&"changing_story"])

[sub_resource type="Resource" id="Resource_q43ak"]
script = ExtResource("2_4ghgh")
text = "Evacuating the school. Units are on the way."
next = &"units_school"

[sub_resource type="Resource" id="Resource_3b0nf"]
script = ExtResource("1_x88u4")
id = &"where"
line = "In the... the gym. No, the math wing. It's hidden. You'll never find it."
choices = Array[ExtResource("2_4ghgh")]([SubResource("Resource_165w2"), SubResource("Resource_q43ak")])

[sub_resource type="Resource" id="Resource_sg8ek"]
script = ExtResource("2_4ghgh")
text = "[Tech] Checking this number."
next = &"tech"
required_class = &"tech"
reveals = Array[StringName]([&"prepaid_phone"])

[sub_resource type="Resource" id="Resource_aghyr"]
script = ExtResource("2_4ghgh")
text = "Is there an exam at eight?"
next = &"exam"
reveals = Array[StringName]([&"exam_day"])

[sub_resource type="Resource" id="Resource_g67bl"]
script = ExtResource("1_x88u4")
id = &"why"
line = "Because... the system is broken. And stuff."
choices = Array[ExtResource("2_4ghgh")]([SubResource("Resource_sg8ek"), SubResource("Resource_aghyr")])

[sub_resource type="Resource" id="Resource_5tfcq"]
script = ExtResource("1_x88u4")
id = &"listen"
speaker = &"dispatcher"
line = "(Under the voice changer: a video game menu jingle and a microwave beeping.)"
auto_next = &"listen_after"
auto_delay = 3.5

[sub_resource type="Resource" id="Resource_h3elq"]
script = ExtResource("2_4ghgh")
text = "Pause your game, kid."
next = &"end_confess"
required_evidence = Array[StringName]([&"game_audio"])
patience_delta = -20.0

[sub_resource type="Resource" id="Resource_p5lr2"]
script = ExtResource("2_4ghgh")
text = "Is there an exam at eight?"
next = &"exam"

[sub_resource type="Resource" id="Resource_5s8ei"]
script = ExtResource("1_x88u4")
id = &"listen_after"
line = "Did you hear me? A bomb!"
choices = Array[ExtResource("2_4ghgh")]([SubResource("Resource_h3elq"), SubResource("Resource_p5lr2")])

[sub_resource type="Resource" id="Resource_vg8ni"]
script = ExtResource("1_x88u4")
id = &"exam"
line = "(the voice changer glitches — a teenage boy) N-no! Maybe! What does that matter?"
auto_next = &"end_confess"
auto_delay = 3.0

[sub_resource type="Resource" id="Resource_ib610"]
script = ExtResource("1_x88u4")
id = &"tech"
speaker = &"dispatcher"
line = "(Prepaid phone sold at the Aspen Drive gas station. Two previous fake threats against the high school.)"
auto_next = &"caught_story"
auto_delay = 4.0

[sub_resource type="Resource" id="Resource_rxpyj"]
script = ExtResource("2_4ghgh")
text = "You're calling from a prepaid phone bought on Aspen Drive."
next = &"end_confess"
required_evidence = Array[StringName]([&"prepaid_phone"])

[sub_resource type="Resource" id="Resource_wd5li"]
script = ExtResource("2_4ghgh")

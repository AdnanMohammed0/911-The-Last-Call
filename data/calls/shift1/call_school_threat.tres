choices = Array[ExtResource("2_4ghgh")]([SubResource("Resource_rxpyj"), SubResource("Resource_wd5li")])

[sub_resource type="Resource" id="Resource_pxmkx"]
script = ExtResource("1_x88u4")
id = &"units_school"
line = "(laughing off-mic) 'They're evacuating!' ...Good. (click)"
on_enter_events = Array[StringName]([&"dispatch_units"])

[sub_resource type="Resource" id="Resource_kg00g"]
script = ExtResource("2_4ghgh")

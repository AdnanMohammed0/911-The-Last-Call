[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://core/audio/ambience_track.gd" id="1_0"]

[sub_resource type="Resource" id="StationOpsRoom"]
script = ExtResource("1_0")
id = &"station_ops_room"
name = "Station 4 — Operations Room"
description = "Constant low hum of CRT monitors, analog phone system, HVAC, distant radio chatter. The heartbeat of the dispatch phase."
category = 0
layers = Array[Dictionary]([
{ "file": "res://audio/ambience/station_ops_room_base.wav", "volume_db": -18.0, "loop": true, "fade_in": 2.0, "fade_out": 1.0 },
{ "file": "res://audio/ambience/station_crt_hum.wav", "volume_db": -24.0, "loop": true, "fade_in": 1.0, "fade_out": 0.5 },
{ "file": "res://audio/ambience/station_hvac.wav", "volume_db": -20.0, "loop": true, "fade_in": 3.0, "fade_out": 1.5 },
{ "file": "res://audio/ambience/station_radio_chatter.wav", "volume_db": -26.0, "loop": true, "fade_in": 2.0, "fade_out": 1.0, "random_start": true },
{ "file": "res://audio/ambience/station_typing.wav", "volume_db": -22.0, "loop": true, "fade_in": 1.0, "fade_out": 0.5, "probability": 0.3 },
{ "file": "res://audio/ambience/station_coffee_machine.wav", "volume_db": -30.0, "loop": false, "fade_in": 0.5, "fade_out": 2.0, "probability": 0.1, "interval_range": [60.0, 180.0] }
])
transition_to = Array[StringName]([&"station_garage", &"station_armory", &"field_dispatch"])

[sub_resource type="Resource" id="StationGarage"]
script = ExtResource("1_0")
id = &"station_garage"

caller_name = "Brianna"
caller_location_name = "Blackvale Mall, food court"
true_location = Vector2(500, 260)
records = Array[ExtResource("5_jgjh2")]([SubResource("Resource_bo2ah"), SubResource("Resource_dgbyy")])

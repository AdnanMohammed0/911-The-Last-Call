[sub_resource type="Resource" id="Resource_dcmch"]
script = ExtResource("2_h5tvm")
text = "We are dispatching units Code 3 immediately!"
next = &"hasty_dispatch"
patience_delta = -15.0

[sub_resource type="Resource" id="Resource_mbdth"]
script = ExtResource("1_cinvk")
id = &"start"
line = "Help! There are people in robes surrounding my farmhouse... they're cutting the power lines!"

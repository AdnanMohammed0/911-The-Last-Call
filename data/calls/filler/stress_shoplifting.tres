[gd_resource type="Resource" script_class="StressProfile" format=3]

[ext_resource type="Script" path="res://data/calls/stress_profile.gd" id="1_sp"]
[ext_resource type="Resource" path="res://data/calls/curves/tremor_urgent.tres" id="2_tremor"]
[ext_resource type="Resource" path="res://data/calls/curves/pitch_urgent.tres" id="3_pitch"]

[resource]
script = ExtResource("1_sp")
tremor_curve = ExtResource("2_tremor")
pitch_variance = ExtResource("3_pitch")
loop_segments = []
background_tags = [&"store_ambience", &"cooler_hum", &"footsteps"]
baseline_heart_rate = 105
emf_frequency = 0.0
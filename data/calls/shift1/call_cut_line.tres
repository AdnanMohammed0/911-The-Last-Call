[gd_resource type="Resource" script_class="CallData" format=3]

[ext_resource type="Script" path="res://data/dialogue/dialogue_node.gd" id="1_acnhv"]
[ext_resource type="Script" path="res://data/dialogue/dialogue_choice.gd" id="2_6xbfk"]
[ext_resource type="Script" path="res://data/consequences/flag_condition.gd" id="3_615ev"]
[ext_resource type="Script" path="res://data/dialogue/dialogue_graph.gd" id="4_npk6d"]
[ext_resource type="Script" path="res://data/calls/record_entry.gd" id="5_iucrx"]
[ext_resource type="Script" path="res://data/calls/call_data.gd" id="6_u750s"]
[ext_resource type="Script" path="res://data/calls/stress_profile.gd" id="7_3wx1o"]

[sub_resource type="Resource" id="Resource_mmp0q"]
script = ExtResource("2_6xbfk")
text = "What's your address?"
next = &"address"

[sub_resource type="Resource" id="Resource_2hout"]
script = ExtResource("2_6xbfk")
text = "Where are you hiding?"
next = &"hiding"

[sub_resource type="Resource" id="Resource_t7lc7"]
script = ExtResource("2_6xbfk")
text = "[Profiler] Keep whispering. Tell me what you hear."
next = &"listen"
required_class = &"profiler"

[sub_resource type="Resource" id="Resource_cruym"]
script = ExtResource("1_acnhv")
id = &"start"
line = "(whispering) There's someone in my house. They're downstairs. Please."
choices = Array[ExtResource("2_6xbfk")]([SubResource("Resource_mmp0q"), SubResource("Resource_2hout"), SubResource("Resource_t7lc7")])

[sub_resource type="Resource" id="Resource_iwn40"]
script = ExtResource("2_6xbfk")
text = "[Tech] Checking the address on the county database."
next = &"tech_address"
required_class = &"tech"
reveals = Array[StringName]([&"vacant_address"])

[sub_resource type="Resource" id="Resource_76kk1"]
script = ExtResource("2_6xbfk")
text = "How many people are in the house?"
next = &"how_many"

[sub_resource type="Resource" id="Resource_1mxv8"]
script = ExtResource("2_6xbfk")
text = "Where are you hiding?"
next = &"hiding"

[sub_resource type="Resource" id="Resource_w8yta"]
script = ExtResource("1_acnhv")
id = &"address"
line = "22 Willow Court. Please send everyone, all of them."
choices = Array[ExtResource("2_6xbfk")]([SubResource("Resource_iwn40"), SubResource("Resource_76kk1"), SubResource("Resource_1mxv8")])

[sub_resource type="Resource" id="Resource_pb5vi"]
script = ExtResource("1_acnhv")
id = &"tech_address"
speaker = &"dispatcher"
line = "(County records: 22 Willow Court is bank-owned. Power cut off since March.)"
auto_next = &"tech_after"
auto_delay = 3.5

[sub_resource type="Resource" id="Resource_jkav5"]
script = ExtResource("2_6xbfk")
text = "Ma'am, the power at that address was cut months ago. How is your phone charging?"
next = &"confront_power"
required_evidence = Array[StringName]([&"vacant_address"])
patience_delta = -30.0

[sub_resource type="Resource" id="Resource_4r3px"]
script = ExtResource("2_6xbfk")
text = "Where are you hiding?"
next = &"hiding"

[sub_resource type="Resource" id="Resource_xpagy"]
script = ExtResource("1_acnhv")
id = &"tech_after"
line = "(still whispering) Why aren't you saying anything? Are they coming?"
choices = Array[ExtResource("2_6xbfk")]([SubResource("Resource_jkav5"), SubResource("Resource_4r3px")])

[sub_resource type="Resource" id="Resource_6w14k"]
script = ExtResource("2_6xbfk")
text = "[Profiler] Your breathing hasn't changed once. You're not scared."
next = &"profiler_calm"
required_class = &"profiler"
reveals = Array[StringName]([&"calm_breathing"])

[sub_resource type="Resource" id="Resource_siyr2"]
script = ExtResource("2_6xbfk")
text = "Units are on the way."
next = &"end_dispatch"

[sub_resource type="Resource" id="Resource_c27n1"]
script = ExtResource("1_acnhv")
id = &"confront_power"
line = "(pause) ...I have a battery. Just send the units. Send all of them."
choices = Array[ExtResource("2_6xbfk")]([SubResource("Resource_6w14k"), SubResource("Resource_siyr2")])

[sub_resource type="Resource" id="Resource_jrai8"]
script = ExtResource("1_acnhv")
id = &"profiler_calm"
line = "(a man's voice in the background, close to the phone) 'She's made us. Hang up.'"
auto_next = &"end_click"
auto_delay = 3.0

[sub_resource type="Resource" id="Resource_8ypin"]
script = ExtResource("2_6xbfk")
text = "Describe the house. What's across the hall?"
next = &"house"

[sub_resource type="Resource" id="Resource_udsot"]
script = ExtResource("2_6xbfk")
text = "How many people are in the house?"
next = &"how_many"

[sub_resource type="Resource" id="Resource_wbueh"]
script = ExtResource("1_acnhv")
id = &"hiding"
line = "In the upstairs closet. I can hear them on the stairs."
choices = Array[ExtResource("2_6xbfk")]([SubResource("Resource_8ypin"), SubResource("Resource_udsot")])

[sub_resource type="Resource" id="Resource_pt488"]
script = ExtResource("2_6xbfk")
text = "You have kids? Where are they?"
next = &"kids"
patience_delta = 10.0

[sub_resource type="Resource" id="Resource_fq2ec"]
script = ExtResource("2_6xbfk")
text = "[Profiler] Listen for me — is anything running in the background?"
next = &"listen"
required_class = &"profiler"

[sub_resource type="Resource" id="Resource_ce4er"]
script = ExtResource("1_acnhv")
id = &"house"
line = "Uh... the bathroom. And the kids' room. The stairs creak... the fourth step."
choices = Array[ExtResource("2_6xbfk")]([SubResource("Resource_pt488"), SubResource("Resource_fq2ec")])

[sub_resource type="Resource" id="Resource_xrm1q"]
script = ExtResource("2_6xbfk")
text = "Which grandmother? I can check on them too."
next = &"grandmother"
reveals = Array[StringName]([&"evasive_answer"])

[sub_resource type="Resource" id="Resource_5jocn"]
script = ExtResource("2_6xbfk")
text = "Units are on the way."
next = &"end_dispatch"

[sub_resource type="Resource" id="Resource_o0fn3"]
script = ExtResource("1_acnhv")
id = &"kids"
line = "They're... at their grandmother's. Just send someone."
choices = Array[ExtResource("2_6xbfk")]([SubResource("Resource_xrm1q"), SubResource("Resource_5jocn")])

[sub_resource type="Resource" id="Resource_acdx2"]
script = ExtResource("1_acnhv")
id = &"grandmother"
line = "It doesn't matter! Stop asking questions and send the police!"
auto_next = &"end_dispatch"
auto_delay = 3.0

[sub_resource type="Resource" id="Resource_j3dar"]
script = ExtResource("2_6xbfk")
text = "You saw rifles from inside a closet?"
next = &"rifles"
patience_delta = -15.0
reveals = Array[StringName]([&"inconsistent_story"])

[sub_resource type="Resource" id="Resource_3wqox"]
script = ExtResource("2_6xbfk")
text = "Stay hidden. Units are coming."
next = &"end_dispatch"

[sub_resource type="Resource" id="Resource_kpxlr"]
script = ExtResource("1_acnhv")
id = &"how_many"
line = "Three. Maybe four. They have guns, I saw rifles."
choices = Array[ExtResource("2_6xbfk")]([SubResource("Resource_j3dar"), SubResource("Resource_3wqox")])

[sub_resource type="Resource" id="Resource_xt728"]
script = ExtResource("2_6xbfk")
text = "[Profiler] That sentence sounds rehearsed."
next = &"listen"
required_class = &"profiler"

[sub_resource type="Resource" id="Resource_ib048"]
script = ExtResource("2_6xbfk")
text = "Units are on the way."
next = &"end_dispatch"

[sub_resource type="Resource" id="Resource_xkqkc"]
script = ExtResource("1_acnhv")
id = &"rifles"
line = "I— before. I saw them through the window before I hid."
choices = Array[ExtResource("2_6xbfk")]([SubResource("Resource_xt728"), SubResource("Resource_ib048")])

[sub_resource type="Resource" id="Resource_v44pp"]
script = ExtResource("1_acnhv")
id = &"listen"
speaker = &"dispatcher"
line = "(Behind her: an idling engine, and the same whispered sentence repeating a second time.)"
auto_next = &"listen_after"
auto_delay = 4.0

[sub_resource type="Resource" id="Resource_tk3ou"]
script = ExtResource("2_6xbfk")
text = "That's the exact same recording. Who am I really talking to?"
next = &"confront_loop"
patience_delta = -40.0
reveals = Array[StringName]([&"looped_audio"])

[sub_resource type="Resource" id="Resource_mnqr2"]
script = ExtResource("2_6xbfk")
text = "Units are on the way."
next = &"end_dispatch"

[sub_resource type="Resource" id="Resource_du5fm"]
script = ExtResource("1_acnhv")
id = &"listen_after"
line = "There's someone in my house. They're downstairs. Please."
choices = Array[ExtResource("2_6xbfk")]([SubResource("Resource_tk3ou"), SubResource("Resource_mnqr2")])

[sub_resource type="Resource" id="Resource_tcbbd"]
script = ExtResource("1_acnhv")
id = &"confront_loop"
speaker = &"unknown"
line = "(A man laughs softly.) 'Just send the cars, dispatcher. We're waiting.'"
auto_next = &"end_click"
auto_delay = 3.0

[sub_resource type="Resource" id="Resource_5xqvb"]
script = ExtResource("1_acnhv")
id = &"end_click"
speaker = &"dispatcher"
line = "(Click. The line is cut.)"

[sub_resource type="Resource" id="Resource_a6pwr"]
script = ExtResource("1_acnhv")
id = &"end_dispatch"
line = "(whispering) Thank you. Tell them to come to the front door."
on_enter_events = Array[StringName]([&"dispatch_units"])

[sub_resource type="Resource" id="Resource_kxspf"]
script = ExtResource("4_npk6d")
nodes = Array[ExtResource("1_acnhv")]([SubResource("Resource_cruym"), SubResource("Resource_w8yta"), SubResource("Resource_pb5vi"), SubResource("Resource_xpagy"), SubResource("Resource_c27n1"), SubResource("Resource_jrai8"), SubResource("Resource_wbueh"), SubResource("Resource_ce4er"), SubResource("Resource_o0fn3"), SubResource("Resource_acdx2"), SubResource("Resource_kpxlr"), SubResource("Resource_xkqkc"), SubResource("Resource_v44pp"), SubResource("Resource_du5fm"), SubResource("Resource_tcbbd"), SubResource("Resource_5xqvb"), SubResource("Resource_a6pwr")])

[sub_resource type="Resource" id="Resource_iq3yf"]
script = ExtResource("5_iucrx")
id = &"rec_willow_22"
title = "22 Willow Court"
content = "Bank-owned since March. Utilities disconnected. No registered occupants."

[sub_resource type="Resource" id="Resource_bcdvp"]
script = ExtResource("5_iucrx")
id = &"rec_decoy_calls"
title = "Decoy call pattern"
content = "Two deputies wounded in 2019 after a fake break-in call to a vacant address."

[sub_resource type="Curve" id="Curve_uc5uw"]
_data = [Vector2(0, 0.1), 0.0, 0.0, 0, 0, Vector2(1, 0.12), 0.0, 0.0, 0, 0]
point_count = 2

[sub_resource type="Resource" id="Resource_xgeed"]
script = ExtResource("7_3wx1o")
tremor_curve = SubResource("Curve_uc5uw")
loop_segments = Array[Vector2]([Vector2(2, 5.5)])
background_tags = Array[StringName]([&"steady_breathing", &"engine_idle"])
baseline_heart_rate = 64

[resource]
script = ExtResource("6_u750s")
id = &"call_cut_line"
title = "The Cut Line"
truth = 2
earliest_minute = 7
dialogue = SubResource("Resource_kxspf")
phone_number = "911-555-0133"
caller_location_name = "22 Willow Court"
true_location = Vector2(300, 410)
records = Array[ExtResource("5_iucrx")]([SubResource("Resource_iq3yf"), SubResource("Resource_bcdvp")])
stress_profile = SubResource("Resource_xgeed")
patience_seconds = 150.0

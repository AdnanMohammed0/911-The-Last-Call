[gd_resource type="Resource" script_class="CallData" format=3]

[ext_resource type="Script" path="res://data/dialogue/dialogue_node.gd" id="1_slxc6"]
[ext_resource type="Script" path="res://data/dialogue/dialogue_choice.gd" id="2_sjkxi"]
[ext_resource type="Script" path="res://data/consequences/flag_condition.gd" id="3_c47be"]
[ext_resource type="Script" path="res://data/dialogue/dialogue_graph.gd" id="4_1nt34"]
[ext_resource type="Script" path="res://data/calls/record_entry.gd" id="5_jgjh2"]
[ext_resource type="Script" path="res://data/calls/call_data.gd" id="6_dqj54"]
[ext_resource type="Script" path="res://data/calls/stress_profile.gd" id="7_ta6s1"]

[sub_resource type="Resource" id="Resource_dxu33"]
script = ExtResource("2_sjkxi")
text = "Stay where you are. Units are on the way."
next = &"units_mall"

[sub_resource type="Resource" id="Resource_qygxe"]
script = ExtResource("2_sjkxi")
text = "What time is it where you are?"
next = &"time"

[sub_resource type="Resource" id="Resource_er887"]
script = ExtResource("2_sjkxi")
text = "Describe the man."
next = &"man"

[sub_resource type="Resource" id="Resource_bbui6"]
script = ExtResource("2_sjkxi")
text = "What's your full name and address?"
next = &"name"

[sub_resource type="Resource" id="Resource_1y2q5"]
script = ExtResource("1_slxc6")
id = &"start"
line = "Hi, um, I'm like, lost? At the mall? And my mom's gone and there's a scary man. (muffled giggle)"
choices = Array[ExtResource("2_sjkxi")]([SubResource("Resource_dxu33"), SubResource("Resource_qygxe"), SubResource("Resource_er887"), SubResource("Resource_bbui6")])

[sub_resource type="Resource" id="Resource_7kbqn"]
script = ExtResource("2_sjkxi")
text = "It's the middle of the night. The mall closed hours ago."
next = &"caught_time"
patience_delta = -20.0
reveals = Array[StringName]([&"wrong_time"])

[sub_resource type="Resource" id="Resource_sfhfp"]
script = ExtResource("2_sjkxi")
text = "Describe the man."
next = &"man"

[sub_resource type="Resource" id="Resource_1yxjv"]
script = ExtResource("1_slxc6")
id = &"time"
line = "It's like... two in the afternoon?"
choices = Array[ExtResource("2_sjkxi")]([SubResource("Resource_7kbqn"), SubResource("Resource_sfhfp")])

[sub_resource type="Resource" id="Resource_dvt1g"]
script = ExtResource("2_sjkxi")
text = "[Tech] Your number is registered to 8 Aspen Drive."
next = &"tech_number"
required_class = &"tech"
reveals = Array[StringName]([&"home_address"])

[sub_resource type="Resource" id="Resource_ey3q4"]
script = ExtResource("2_sjkxi")
text = "Locked in? Then describe the store you're in front of."
next = &"store"

[sub_resource type="Resource" id="Resource_us16a"]
script = ExtResource("1_slxc6")
id = &"caught_time"
line = "(background: 'Bri, she knows, hang up!') N-no, I mean, I got locked in!"
choices = Array[ExtResource("2_sjkxi")]([SubResource("Resource_dvt1g"), SubResource("Resource_ey3q4")])

[sub_resource type="Resource" id="Resource_lakga"]
script = ExtResource("2_sjkxi")
text = "There's no Pizza Planet in Blackvale Mall."
next = &"end_confess"
patience_delta = -30.0

[sub_resource type="Resource" id="Resource_tsqc2"]
script = ExtResource("1_slxc6")
id = &"store"
line = "Um... the... pizza one. Pizza Planet."
choices = Array[ExtResource("2_sjkxi")]([SubResource("Resource_lakga")])

[sub_resource type="Resource" id="Resource_hj0n0"]
script = ExtResource("2_sjkxi")
text = "[Profiler] Who's laughing next to you, Brianna?"
next = &"profiler_friends"
required_class = &"profiler"
reveals = Array[StringName]([&"friends_present"])

[sub_resource type="Resource" id="Resource_vc1b6"]
script = ExtResource("2_sjkxi")
text = "What time is it where you are?"
next = &"time"

[sub_resource type="Resource" id="Resource_lcl5y"]
script = ExtResource("1_slxc6")
id = &"man"
line = "He's got, like, a big hat and he's super tall and he's got... (laughter) sorry, sorry—"
choices = Array[ExtResource("2_sjkxi")]([SubResource("Resource_hj0n0"), SubResource("Resource_vc1b6")])

[sub_resource type="Resource" id="Resource_lac67"]
script = ExtResource("2_sjkxi")
text = "Mall food courts don't have TVs you can turn off. You're at home."
next = &"end_confess"
required_evidence = Array[StringName]([&"friends_present"])

[sub_resource type="Resource" id="Resource_o3ca6"]
script = ExtResource("2_sjkxi")
text = "What's your full name and address?"
next = &"name"

[sub_resource type="Resource" id="Resource_cj8jf"]
script = ExtResource("1_slxc6")
id = &"profiler_friends"
line = "Nobody! It's the TV! (music in the background suddenly stops)"
choices = Array[ExtResource("2_sjkxi")]([SubResource("Resource_lac67"), SubResource("Resource_o3ca6")])

[sub_resource type="Resource" id="Resource_b1id0"]
script = ExtResource("2_sjkxi")
text = "[Tech] Checking this number's history."
next = &"tech_number"
required_class = &"tech"
reveals = Array[StringName]([&"home_address"])

[sub_resource type="Resource" id="Resource_2kjy2"]
script = ExtResource("2_sjkxi")
text = "Brianna, calling 911 as a joke is a crime."
next = &"end_confess"
patience_delta = -10.0

[sub_resource type="Resource" id="Resource_sxutu"]
script = ExtResource("1_slxc6")
id = &"name"
line = "Brianna... Smith. I live at... the mall."
choices = Array[ExtResource("2_sjkxi")]([SubResource("Resource_b1id0"), SubResource("Resource_2kjy2")])

[sub_resource type="Resource" id="Resource_2s6bg"]
script = ExtResource("1_slxc6")
id = &"tech_number"
speaker = &"dispatcher"
line = "(Four prank calls from this number this month. Registered to the Keller family.)"
auto_next = &"tech_after"
auto_delay = 3.0

[sub_resource type="Resource" id="Resource_wltwr"]
script = ExtResource("2_sjkxi")
text = "Brianna Keller. A deputy can visit your parents tonight."
next = &"end_confess"
required_evidence = Array[StringName]([&"home_address"])

[sub_resource type="Resource" id="Resource_cmp0q"]
script = ExtResource("1_slxc6")
id = &"tech_after"
line = "(whispering off the phone) 'How does she know my house?'"
choices = Array[ExtResource("2_sjkxi")]([SubResource("Resource_wltwr")])

[sub_resource type="Resource" id="Resource_j4xou"]
script = ExtResource("1_slxc6")
id = &"units_mall"
line = "(whispers 'they're actually sending cops!') ...Okay, thanks! (click)"
on_enter_events = Array[StringName]([&"dispatch_units"])

[sub_resource type="Resource" id="Resource_t5mks"]
script = ExtResource("2_sjkxi")
text = "A deputy is coming to Aspen Drive. You're under arrest for a false report."
next = &"arrest_sent"

[sub_resource type="Resource" id="Resource_tcxl4"]
script = ExtResource("2_sjkxi")
text = "This is your only warning. I'm logging this as a prank call."
next = &"warned"
patience_delta = 10.0

[sub_resource type="Resource" id="Resource_34q1k"]
script = ExtResource("1_slxc6")
id = &"end_confess"
line = "(crying) Okay, okay, I'm sorry, it was a dare! Please don't tell my mom!"
choices = Array[ExtResource("2_sjkxi")]([SubResource("Resource_t5mks"), SubResource("Resource_tcxl4")])

[sub_resource type="Resource" id="Resource_p0u75"]
script = ExtResource("1_slxc6")
id = &"arrest_sent"
speaker = &"dispatcher"
line = "(Deputies dispatched to 8 Aspen Drive. The line clicks — she hung up.)"
on_enter_events = Array[StringName]([&"dispatch_arrest"])

[sub_resource type="Resource" id="Resource_k7108"]
script = ExtResource("1_slxc6")
id = &"warned"
line = "Thank you, thank you, it won't happen again. (click)"

[sub_resource type="Resource" id="Resource_aoal3"]
script = ExtResource("4_1nt34")
nodes = Array[ExtResource("1_slxc6")]([SubResource("Resource_1y2q5"), SubResource("Resource_1yxjv"), SubResource("Resource_us16a"), SubResource("Resource_tsqc2"), SubResource("Resource_lcl5y"), SubResource("Resource_cj8jf"), SubResource("Resource_sxutu"), SubResource("Resource_2s6bg"), SubResource("Resource_cmp0q"), SubResource("Resource_j4xou"), SubResource("Resource_34q1k"), SubResource("Resource_p0u75"), SubResource("Resource_k7108")])


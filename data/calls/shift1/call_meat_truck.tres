[gd_resource type="Resource" script_class="CallData" format=3]

[ext_resource type="Script" path="res://data/dialogue/dialogue_node.gd" id="1_0tmbe"]
[ext_resource type="Script" path="res://data/dialogue/dialogue_choice.gd" id="2_hfs46"]
[ext_resource type="Script" path="res://data/consequences/flag_condition.gd" id="3_hirj7"]
[ext_resource type="Script" path="res://data/dialogue/dialogue_graph.gd" id="4_chek6"]
[ext_resource type="Script" path="res://data/calls/record_entry.gd" id="5_l2ges"]
[ext_resource type="Script" path="res://data/calls/call_data.gd" id="6_kbftd"]
[ext_resource type="Script" path="res://data/calls/stress_profile.gd" id="7_unvpf"]

[sub_resource type="Resource" id="Resource_1ag2w"]
script = ExtResource("2_hfs46")
text = "Banging from inside? Are you sure?"
next = &"banging"

[sub_resource type="Resource" id="Resource_bjgic"]
script = ExtResource("2_hfs46")
text = "Where exactly are you?"
next = &"where"

[sub_resource type="Resource" id="Resource_uub67"]
script = ExtResource("2_hfs46")
text = "Is anyone guarding the truck?"
next = &"guards"

[sub_resource type="Resource" id="Resource_a8pqt"]
script = ExtResource("1_0tmbe")
id = &"start"
line = "Yeah, I'm a trucker, I'm parked at the harbor... there's a refrigerated box truck here and somebody's banging inside it."
choices = Array[ExtResource("2_hfs46")]([SubResource("Resource_1ag2w"), SubResource("Resource_bjgic"), SubResource("Resource_uub67")])

[sub_resource type="Resource" id="Resource_g3od6"]
script = ExtResource("2_hfs46")
text = "[Profiler] That's a pattern. Knock three times back on the door."
next = &"knock_back"
required_class = &"profiler"
patience_delta = 10.0

[sub_resource type="Resource" id="Resource_8a4px"]
script = ExtResource("2_hfs46")
text = "Don't go near it. Is anyone guarding it?"
next = &"guards"

[sub_resource type="Resource" id="Resource_mxibh"]
script = ExtResource("2_hfs46")
text = "Can you read the plate or the company name?"
next = &"plate"

[sub_resource type="Resource" id="Resource_fwg0k"]
script = ExtResource("1_0tmbe")
id = &"banging"
line = "Listen— (metal knocking, three, then three again) Hear that? That's people."
choices = Array[ExtResource("2_hfs46")]([SubResource("Resource_g3od6"), SubResource("Resource_8a4px"), SubResource("Resource_mxibh")])

[sub_resource type="Resource" id="Resource_govuv"]
script = ExtResource("2_hfs46")
text = "Can you open the back?"
next = &"open_truck"
patience_delta = -10.0
reveals = Array[StringName]([&"people_inside"])

[sub_resource type="Resource" id="Resource_4ds7x"]
script = ExtResource("2_hfs46")
text = "Don't open it. Are there armed men nearby?"
next = &"guards"
reveals = Array[StringName]([&"people_inside"])

[sub_resource type="Resource" id="Resource_tdoe4"]
script = ExtResource("1_0tmbe")
id = &"knock_back"
line = "(knock, knock, knock) ...Three back. And a voice. A kid's voice. Oh no. Oh no no."
choices = Array[ExtResource("2_hfs46")]([SubResource("Resource_govuv"), SubResource("Resource_4ds7x")])

[sub_resource type="Resource" id="Resource_vyf1w"]
script = ExtResource("2_hfs46")
text = "Do it, carefully."
next = &"cut_lock"
patience_delta = -20.0

[sub_resource type="Resource" id="Resource_pmhx3"]
script = ExtResource("2_hfs46")
text = "Wait. Check if anyone's watching you first."
next = &"guards"

[sub_resource type="Resource" id="Resource_bc7s8"]
script = ExtResource("1_0tmbe")
id = &"open_truck"
line = "There's a padlock. I've got bolt cutters in my rig, I could—"
choices = Array[ExtResource("2_hfs46")]([SubResource("Resource_vyf1w"), SubResource("Resource_pmhx3")])

[sub_resource type="Resource" id="Resource_fotvn"]
script = ExtResource("2_hfs46")
text = "Get back in your truck and drive away. Now."
next = &"end_flee"

[sub_resource type="Resource" id="Resource_wouf6"]
script = ExtResource("2_hfs46")
text = "Hide and tell me how many."
next = &"count_guards"
patience_delta = 10.0

[sub_resource type="Resource" id="Resource_5ifcl"]
script = ExtResource("1_0tmbe")
id = &"cut_lock"
line = "(a car door slams somewhere) Somebody's coming out of the warehouse. They've got guns."
choices = Array[ExtResource("2_hfs46")]([SubResource("Resource_fotvn"), SubResource("Resource_wouf6")])

[sub_resource type="Resource" id="Resource_0k2ds"]
script = ExtResource("2_hfs46")
text = "How many men total?"
next = &"count_guards"

[sub_resource type="Resource" id="Resource_hl0py"]
script = ExtResource("2_hfs46")
text = "Stay out of sight. What's written on the truck?"
next = &"plate"

[sub_resource type="Resource" id="Resource_kyjdn"]
script = ExtResource("1_0tmbe")
id = &"guards"
line = "Two cars by the warehouse door. Guys smoking out front. One's got a rifle under his coat."
choices = Array[ExtResource("2_hfs46")]([SubResource("Resource_0k2ds"), SubResource("Resource_hl0py")])

[sub_resource type="Resource" id="Resource_0gn45"]
script = ExtResource("2_hfs46")
text = "[Tech] What's the warehouse number? I'll pull the lease."
next = &"tech_lease"
required_class = &"tech"
reveals = Array[StringName]([&"dissolved_company"])

[sub_resource type="Resource" id="Resource_j6sbf"]
script = ExtResource("2_hfs46")
text = "Good work. Get somewhere safe, units are rolling."
next = &"end_units"
reveals = Array[StringName]([&"armed_suspects"])

[sub_resource type="Resource" id="Resource_5xt26"]
script = ExtResource("1_0tmbe")
id = &"count_guards"
line = "Four outside... there's light upstairs in the office too. Maybe more in there."
choices = Array[ExtResource("2_hfs46")]([SubResource("Resource_0gn45"), SubResource("Resource_j6sbf")])

[sub_resource type="Resource" id="Resource_h4h7c"]
script = ExtResource("1_0tmbe")
id = &"tech_lease"
speaker = &"dispatcher"
line = "(Lease record: Blackvale Meats LLC, dissolved in 2021. Nobody should be storing anything here.)"
auto_next = &"end_units"
auto_delay = 4.0

[sub_resource type="Resource" id="Resource_k1rxr"]
script = ExtResource("2_hfs46")
text = "Covered on purpose. How many men are there?"
next = &"count_guards"
reveals = Array[StringName]([&"hidden_plate"])

[sub_resource type="Resource" id="Resource_gqs7f"]
script = ExtResource("1_0tmbe")
id = &"plate"
line = "'Blackvale Meats'. Plate starts K-7... I can't see the rest, it's covered in mud."
choices = Array[ExtResource("2_hfs46")]([SubResource("Resource_k1rxr")])

[sub_resource type="Resource" id="Resource_78a71"]
script = ExtResource("2_hfs46")
text = "Is anyone guarding the truck?"
next = &"guards"

[sub_resource type="Resource" id="Resource_qoxke"]
script = ExtResource("2_hfs46")
text = "Banging from inside? Are you sure?"
next = &"banging"

[sub_resource type="Resource" id="Resource_g7fo0"]
script = ExtResource("1_0tmbe")
id = &"where"
line = "Pier 4, by the old cold storage. There's containers everywhere."
choices = Array[ExtResource("2_hfs46")]([SubResource("Resource_78a71"), SubResource("Resource_qoxke")])

[sub_resource type="Resource" id="Resource_8u4rt"]
script = ExtResource("1_0tmbe")
id = &"end_flee"
line = "(engine starts) I'm out, I'm out. Please, get those people out of that box."
on_enter_events = Array[StringName]([&"dispatch_units"])

[sub_resource type="Resource" id="Resource_t1uku"]
script = ExtResource("1_0tmbe")
id = &"end_units"
line = "Please hurry. It's freezing in there. They won't last all night."
on_enter_events = Array[StringName]([&"dispatch_units"])

[sub_resource type="Resource" id="Resource_kl4v2"]
script = ExtResource("4_chek6")
nodes = Array[ExtResource("1_0tmbe")]([SubResource("Resource_a8pqt"), SubResource("Resource_fwg0k"), SubResource("Resource_tdoe4"), SubResource("Resource_bc7s8"), SubResource("Resource_5ifcl"), SubResource("Resource_kyjdn"), SubResource("Resource_5xt26"), SubResource("Resource_h4h7c"), SubResource("Resource_gqs7f"), SubResource("Resource_g7fo0"), SubResource("Resource_8u4rt"), SubResource("Resource_t1uku")])

[sub_resource type="Resource" id="Resource_5igey"]
script = ExtResource("5_l2ges")
id = &"rec_pier4"
title = "Pier 4 cold storage"
content = "Leased to 'Blackvale Meats LLC' — company dissolved 2021. Two noise complaints this month."

[sub_resource type="Curve" id="Curve_um2bx"]
_data = [Vector2(0, 0.45), 0.0, 0.0, 0, 0, Vector2(1, 0.7), 0.0, 0.0, 0, 0]
point_count = 2

[sub_resource type="Resource" id="Resource_csku7"]
script = ExtResource("7_unvpf")
tremor_curve = SubResource("Curve_um2bx")
background_tags = Array[StringName]([&"reefer_compressor", &"harbor_wind", &"knocking"])
baseline_heart_rate = 104

[resource]
script = ExtResource("6_kbftd")
id = &"call_meat_truck"
title = "The Meat Truck"
earliest_minute = 12
dialogue = SubResource("Resource_kl4v2")
phone_number = "911-555-0161"
caller_name = "Walt Hendricks"
caller_location_name = "Harbor warehouse district, Pier 4"
true_location = Vector2(820, 520)
records = Array[ExtResource("5_l2ges")]([SubResource("Resource_5igey")])
stress_profile = SubResource("Resource_csku7")
patience_seconds = 220.0

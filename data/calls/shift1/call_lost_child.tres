title = "Blackvale Mall"
content = "Closes at 21:00. Security guard on site until 06:00."

[sub_resource type="Resource" id="Resource_dgbyy"]
script = ExtResource("5_jgjh2")
id = &"rec_number_0112"
title = "911-555-0112"
content = "Four prank calls in 30 days. Registered to the Keller family, 8 Aspen Drive."

[sub_resource type="Curve" id="Curve_vgom1"]

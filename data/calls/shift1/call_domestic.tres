[sub_resource type="Resource" id="Resource_8jwbs"]
script = ExtResource("7_cm2ec")
tremor_curve = SubResource("Curve_8yr73")
background_tags = Array[StringName]([&"shouting_through_wall", &"child_crying"])
baseline_heart_rate = 118

[resource]
script = ExtResource("6_6idyy")
id = &"call_domestic"
title = "Thin Walls"
earliest_minute = 130
dialogue = SubResource("Resource_2nrdf")

next = &"arrest_sent"

[sub_resource type="Resource" id="Resource_28q2s"]
script = ExtResource("2_4ghgh")
text = "Log it as a prank and let the school know."
next = &"logged"

[sub_resource type="Resource" id="Resource_3vvqe"]
script = ExtResource("1_x88u4")
id = &"end_confess"
line = "(voice changer off) Okay, okay! I just didn't want to take the exam! Don't call the cops!"
choices = Array[ExtResource("2_4ghgh")]([SubResource("Resource_kg00g"), SubResource("Resource_28q2s")])


[gd_resource type="Resource" script_class="StressProfile" format=3]

[ext_resource type="Script" path="res://data/calls/stress_profile.gd" id="1_sp"]
[ext_resource type="Resource" path="res://data/calls/curves/tremor_annoyed.tres" id="2_tremor"]
[ext_resource type="Resource" path="res://data/calls/curves/pitch_annoyed.tres" id="3_pitch"]

[resource]
script = ExtResource("1_sp")
tremor_curve = ExtResource("2_tremor")
pitch_variance = ExtResource("3_pitch")
loop_segments = []
background_tags = [&"loud_music", &"party_chatter", &"bass_thump"]
baseline_heart_rate = 95
emf_frequency = 0.0